{
  "name": "dsh-ming-bilibili-account",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "B站帳號工具：掃碼登入、帳號狀態與社交工具；登入態同步持久化於 DSH credentials service 與本機憑證檔。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  }
}
