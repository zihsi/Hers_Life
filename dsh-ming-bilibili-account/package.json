{
  "name": "dsh-ming-bilibili-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI的 B 站账号工具：扫码登录、字幕与社交功能共用本机持久化凭证。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "qa": "node ./qa-auth.mjs"
  }
}
