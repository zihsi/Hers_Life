{
  "name": "dsh-ming-bilibili-account",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "溟的 B 站账号工具：扫码登录、查账号能力状态、改昵称。登录态只存进程内存，不落盘。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": ">=0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  }
}
