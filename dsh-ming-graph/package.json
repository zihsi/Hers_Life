{
  "name": "dsh-ming-graph",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "description": "记忆神经元与星图：整合 DSH 归档记忆与 Discord 会话事件，保留服务器／频道／Thread 来源。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
